// Esquema de la plataforma multicanal.
//
// Regla de aislamiento: toda tabla con datos de contenido lleva `canal_id`.
// Las tablas hijas de un video referencian (canal_id, video_id) con una
// clave foránea compuesta, así la base de datos impide que una tarea, activo
// o publicación quede colgada de un video de otro canal.
//
// Nada específico de un canal (marca, horario, pilares, reglas) vive aquí:
// son columnas de `canales` que se llenan con datos.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

// ─────────────────────────── Enumeraciones ───────────────────────────

enum Rol {
  admin
  productor
  revisor
  lector
}

enum EstadoVideo {
  idea
  guion
  verificacion
  produccion
  revision
  aprobado
  programado
  publicado
}

enum EstadoTarea {
  pendiente
  en_curso
  hecha
  bloqueada
}

enum Plataforma {
  youtube
  youtube_shorts
  tiktok
}

enum EstadoEjecucion {
  en_cola
  en_curso
  ok
  error
}

// ─────────────────────────── Usuarios y acceso ───────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?   @map("nombre")
  emailVerified DateTime? @map("email_verificado")
  image         String?   @map("imagen") @db.Text
  esSuperadmin  Boolean   @default(false) @map("es_superadmin")
  activo        Boolean   @default(true)
  creadoEn      DateTime  @default(now()) @map("creado_en")
  actualizadoEn DateTime  @updatedAt @map("actualizado_en")

  accounts          Account[]
  sessions          Session[]
  membresias        Membresia[]
  videosAprobados   Video[]       @relation("VideoAprobadoPor")
  tareasAsignadas   Tarea[]       @relation("TareaResponsable")
  integraciones     Integracion[] @relation("IntegracionConectadaPor")
  ganchosForzados   Video[]       @relation("VideoGanchoForzadoPor")
  ejecuciones       Ejecucion[]   @relation("EjecucionRegistradaPor")
  guiones           Guion[]       @relation("GuionCreadoPor")
  actividad         Actividad[]
  informesGenerados Informe[]     @relation("InformeGeneradoPor")
  informesAprobados Informe[]     @relation("InformeAprobadoPor")

  @@map("users")
}

model Membresia {
  userId   String   @map("user_id")
  canalId  String   @map("canal_id")
  rol      Rol
  creadoEn DateTime @default(now()) @map("creado_en")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  canal Canal @relation(fields: [canalId], references: [id], onDelete: Cascade)

  @@id([userId, canalId])
  @@index([canalId])
  @@map("membresias")
}

// Tablas de Auth.js (adaptador de Prisma). Los nombres de campo los fija la librería.
model Account {
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
  @@map("verification_tokens")
}

// ─────────────────────────── Canales ───────────────────────────

model Canal {
  id               String   @id @default(cuid())
  slug             String   @unique
  nombre           String
  idioma           String   @default("es")
  zonaHoraria      String   @map("zona_horaria")
  /// Hora local de publicación, "HH:mm", en la zona horaria del canal.
  horaPublicacion  String   @map("hora_publicacion") @db.VarChar(5)
  /// Días de publicación, p. ej. ["lun","mie","vie"].
  diasPublicacion  Json     @map("dias_publicacion")
  /// Color de acento en hexadecimal (#RRGGBB).
  colorAcento      String   @map("color_acento") @db.VarChar(7)
  /// Lista de pilares de contenido del canal.
  pilares          Json
  /// Reglas operativas del canal (formatos por video, días de producción, etc.).
  reglas           Json
  /// Tope de gasto en créditos de IA por video, en USD. Null = sin tope definido.
  limiteGastoVideo Decimal? @map("limite_gasto_video") @db.Decimal(10, 2)
  activo           Boolean  @default(true)
  creadoEn         DateTime @default(now()) @map("creado_en")
  actualizadoEn    DateTime @updatedAt @map("actualizado_en")

  membresias    Membresia[]
  videos        Video[]
  tareas        Tarea[]
  activos       Activo[]
  publicaciones Publicacion[]
  metricas      Metrica[]
  ejecuciones   Ejecucion[]
  integraciones Integracion[]
  eventos       EventoCalendario[]
  guiones       Guion[]
  actividad     Actividad[]
  alertas       Alerta[]
  informes      Informe[]

  @@map("canales")
}

// ─────────────────────────── Contenido ───────────────────────────

model Video {
  id                    String      @id @default(cuid())
  canalId               String      @map("canal_id")
  titulo                String      @db.VarChar(300)
  pilar                 String?
  fechaPublicacion      DateTime?   @map("fecha_publicacion")
  estado                EstadoVideo @default(idea)
  gancho                String?     @db.Text
  scoreGancho           Float?      @map("score_gancho")
  /// Desglose del puntaje del gancho (propiedades y sugerencias).
  puntajeGancho         Json?       @map("puntaje_gancho")
  /// Texto de la miniatura (≤ 3 palabras, distinto del título).
  textoMiniatura        String?     @map("texto_miniatura") @db.VarChar(120)
  /// Revisión del título: banderas como sin-cifra, móvil, largo.
  revisionTitulo        Json?       @map("revision_titulo")
  /// Un admin puede dejar avanzar un video con gancho bajo el objetivo.
  ganchoForzadoPorId    String?     @map("gancho_forzado_por_id")
  ganchoForzadoEn       DateTime?   @map("gancho_forzado_en")
  /// Tope de gasto de IA propio del video (USD); si es null rige el del canal.
  limiteGasto           Decimal?    @map("limite_gasto") @db.Decimal(10, 2)
  fuentesOk             Boolean     @default(false) @map("fuentes_ok")
  notas                 String?     @db.Text
  /// Firma de aprobación humana: quién aprobó y cuándo.
  aprobadoPorId         String?     @map("aprobado_por_id")
  aprobadoEn            DateTime?   @map("aprobado_en")
  /// Ficha de publicación (YouTube y TikTok) editada en el panel.
  fichaPublicacion      Json?       @map("ficha_publicacion")
  /// Carpeta del video en Google Drive y documento de la ficha (creados por el panel).
  driveCarpetaId        String?     @map("drive_carpeta_id") @db.VarChar(128)
  driveCarpetaUrl       String?     @map("drive_carpeta_url") @db.Text
  fichaDriveId          String?     @map("ficha_drive_id") @db.VarChar(128)
  fichaDriveUrl         String?     @map("ficha_drive_url") @db.Text
  /// Momento programado en YouTube (publishAt) cuando el panel lo programó.
  youtubeProgramadoPara DateTime?   @map("youtube_programado_para")
  creadoEn              DateTime    @default(now()) @map("creado_en")
  actualizadoEn         DateTime    @updatedAt @map("actualizado_en")

  actividad        Actividad[]
  alertas          Alerta[]
  canal            Canal              @relation(fields: [canalId], references: [id], onDelete: Cascade)
  aprobadoPor      User?              @relation("VideoAprobadoPor", fields: [aprobadoPorId], references: [id], onDelete: SetNull)
  ganchoForzadoPor User?              @relation("VideoGanchoForzadoPor", fields: [ganchoForzadoPorId], references: [id], onDelete: SetNull)
  guiones          Guion[]
  tareas           Tarea[]
  activos          Activo[]
  publicaciones    Publicacion[]
  ejecuciones      Ejecucion[]
  eventos          EventoCalendario[]

  @@unique([canalId, id])
  @@index([canalId, fechaPublicacion])
  @@index([canalId, estado])
  @@map("videos")
}

model Tarea {
  id            String      @id @default(cuid())
  canalId       String      @map("canal_id")
  videoId       String      @map("video_id")
  tipo          String
  descripcion   String?     @db.Text
  responsableId String?     @map("responsable_id")
  estado        EstadoTarea @default(pendiente)
  /// Fuente obligatoria para cerrar tareas de verificación de cifras.
  fuenteUrl     String?     @map("fuente_url") @db.Text
  vence         DateTime?
  creadoEn      DateTime    @default(now()) @map("creado_en")
  actualizadoEn DateTime    @updatedAt @map("actualizado_en")

  canal       Canal @relation(fields: [canalId], references: [id], onDelete: Cascade)
  video       Video @relation(fields: [canalId, videoId], references: [canalId, id], onDelete: Cascade)
  responsable User? @relation("TareaResponsable", fields: [responsableId], references: [id], onDelete: SetNull)

  @@index([canalId, estado])
  @@index([canalId, videoId])
  @@map("tareas")
}

model Activo {
  id       String   @id @default(cuid())
  canalId  String   @map("canal_id")
  videoId  String   @map("video_id")
  tipo     String
  /// Enlace al archivo (Drive u otro). El panel guarda enlaces, no archivos.
  url      String   @db.Text
  version  Int      @default(1)
  creadoEn DateTime @default(now()) @map("creado_en")

  canal Canal @relation(fields: [canalId], references: [id], onDelete: Cascade)
  video Video @relation(fields: [canalId, videoId], references: [canalId, id], onDelete: Cascade)

  @@index([canalId, videoId])
  @@map("activos")
}

model Publicacion {
  id         String     @id @default(cuid())
  canalId    String     @map("canal_id")
  videoId    String     @map("video_id")
  plataforma Plataforma
  url        String?    @db.Text
  /// Identificador en la plataforma (id de video de YouTube o de TikTok).
  externoId  String?    @map("externo_id") @db.VarChar(64)
  programada DateTime?
  publicada  DateTime?
  creadoEn   DateTime   @default(now()) @map("creado_en")

  canal    Canal     @relation(fields: [canalId], references: [id], onDelete: Cascade)
  video    Video     @relation(fields: [canalId, videoId], references: [canalId, id], onDelete: Cascade)
  metricas Metrica[]

  @@unique([canalId, id])
  @@unique([canalId, plataforma, externoId])
  @@index([canalId, videoId])
  @@map("publicaciones")
}

/// Foto acumulada de una publicación a una fecha: cada fila guarda los totales
/// desde que se publicó hasta `fecha` (no los del día). El último registro es el total.
model Metrica {
  id            String        @id @default(cuid())
  canalId       String        @map("canal_id")
  publicacionId String        @map("publicacion_id")
  fecha         DateTime      @db.Date
  vistas        Int?
  /// Retención media en porcentaje (0-100).
  retencion     Float?
  /// CTR de impresiones en porcentaje (0-100).
  ctr           Float?
  likes         Int?
  comentarios   Int?
  compartidos   Int?
  /// Suscriptores ganados atribuidos a la publicación.
  suscriptores  Int?
  fuente        FuenteMetrica @default(manual)
  actualizadoEn DateTime      @default(now()) @updatedAt @map("actualizado_en")

  canal       Canal       @relation(fields: [canalId], references: [id], onDelete: Cascade)
  publicacion Publicacion @relation(fields: [canalId, publicacionId], references: [canalId, id], onDelete: Cascade)

  @@unique([publicacionId, fecha])
  @@index([canalId, fecha])
  @@map("metricas")
}

enum FuenteMetrica {
  youtube_api
  csv
  manual
}

// ─────────────────────────── Integraciones ───────────────────────────

enum ProveedorIntegracion {
  /// YouTube (gestión y analíticas) y Calendar
  google
  /// Google Drive, en una autorización aparte: Google no deja pedirlo junto con YouTube
  google_drive
}

/// Conexión de un canal con un servicio externo (Google: YouTube Analytics + Calendar).
/// El refresh token se guarda cifrado (AES-256-GCM) con INTEGRACIONES_CLAVE.
model Integracion {
  id                   String               @id @default(cuid())
  canalId              String               @map("canal_id")
  proveedor            ProveedorIntegracion
  /// Cuenta o canal conectado (para mostrar), p. ej. el nombre del canal de YouTube.
  cuenta               String?
  youtubeCanalId       String?              @map("youtube_canal_id") @db.VarChar(64)
  calendarioId         String               @default("primary") @map("calendario_id")
  /// Carpeta raíz del canal en Drive (la crea el panel la primera vez).
  driveCarpetaId       String?              @map("drive_carpeta_id") @db.VarChar(128)
  refreshTokenCifrado  String               @map("refresh_token_cifrado") @db.Text
  alcances             String               @db.Text
  conectadoPorId       String?              @map("conectado_por_id")
  ultimaSincronizacion DateTime?            @map("ultima_sincronizacion")
  ultimoError          String?              @map("ultimo_error") @db.Text
  creadoEn             DateTime             @default(now()) @map("creado_en")
  actualizadoEn        DateTime             @updatedAt @map("actualizado_en")

  canal        Canal @relation(fields: [canalId], references: [id], onDelete: Cascade)
  conectadoPor User? @relation("IntegracionConectadaPor", fields: [conectadoPorId], references: [id], onDelete: SetNull)

  @@unique([canalId, proveedor])
  @@map("integraciones")
}

enum OrigenEvento {
  panel
  google
}

/// Eventos del calendario del canal. Los de origen «panel» (publicación,
/// producción) se escriben en Google Calendar; los de origen «google»
/// (reuniones y otros) se leen de allí.
model EventoCalendario {
  id            String       @id @default(cuid())
  canalId       String       @map("canal_id")
  origen        OrigenEvento
  /// publicacion | produccion | reunion
  tipo          String       @db.VarChar(20)
  videoId       String?      @map("video_id")
  googleEventId String?      @map("google_event_id") @db.VarChar(255)
  titulo        String       @db.VarChar(300)
  inicio        DateTime
  fin           DateTime?
  todoElDia     Boolean      @default(false) @map("todo_el_dia")
  actualizadoEn DateTime     @updatedAt @map("actualizado_en")

  canal Canal  @relation(fields: [canalId], references: [id], onDelete: Cascade)
  video Video? @relation(fields: [canalId, videoId], references: [canalId, id], onDelete: Cascade)

  @@unique([canalId, googleEventId])
  @@unique([canalId, videoId, tipo])
  @@index([canalId, inicio])
  @@map("eventos_calendario")
}

model Ejecucion {
  id              String          @id @default(cuid())
  canalId         String          @map("canal_id")
  videoId         String?         @map("video_id")
  tipo            String
  estado          EstadoEjecucion @default(en_cola)
  log             String?         @db.LongText
  /// Enlace a la salida (Drive, etc.). El panel guarda enlaces, no archivos.
  salidaUrl       String?         @map("salida_url") @db.Text
  registradoPorId String?         @map("registrado_por_id")
  /// Costo en USD de la ejecución (créditos de IA, etc.).
  costo           Decimal?        @db.Decimal(10, 4)
  creadoEn        DateTime        @default(now()) @map("creado_en")
  actualizadoEn   DateTime        @updatedAt @map("actualizado_en")

  canal         Canal  @relation(fields: [canalId], references: [id], onDelete: Cascade)
  video         Video? @relation(fields: [canalId, videoId], references: [canalId, id], onDelete: Cascade)
  registradoPor User?  @relation("EjecucionRegistradaPor", fields: [registradoPorId], references: [id], onDelete: SetNull)

  @@index([canalId, estado])
  @@index([canalId, videoId])
  @@map("ejecuciones")
}

/// Borradores de guion de un video, versionados. El panel no publica nada:
/// un guion es un insumo que revisa una persona.
model Guion {
  id          String   @id @default(cuid())
  canalId     String   @map("canal_id")
  videoId     String   @map("video_id")
  version     Int
  contenido   String   @db.LongText
  /// Modelo que lo generó, o null si se escribió a mano.
  modelo      String?  @db.VarChar(64)
  ejecucionId String?  @map("ejecucion_id")
  creadoPorId String?  @map("creado_por_id")
  creadoEn    DateTime @default(now()) @map("creado_en")

  canal     Canal @relation(fields: [canalId], references: [id], onDelete: Cascade)
  video     Video @relation(fields: [canalId, videoId], references: [canalId, id], onDelete: Cascade)
  creadoPor User? @relation("GuionCreadoPor", fields: [creadoPorId], references: [id], onDelete: SetNull)

  @@unique([videoId, version])
  @@index([canalId, videoId])
  @@map("guiones")
}

/// Registro de actividad: quién hizo qué y cuándo. Todo paso que publica
/// (programar en YouTube, registrar un TikTok, marcar publicado) queda aquí.
model Actividad {
  id       String   @id @default(cuid())
  canalId  String   @map("canal_id")
  videoId  String?  @map("video_id")
  userId   String?  @map("user_id")
  /// p. ej. estado_cambiado, drive_ficha, youtube_programado, tiktok_publicado
  accion   String   @db.VarChar(40)
  resumen  String   @db.VarChar(500)
  detalle  Json?
  creadoEn DateTime @default(now()) @map("creado_en")

  canal Canal  @relation(fields: [canalId], references: [id], onDelete: Cascade)
  video Video? @relation(fields: [canalId, videoId], references: [canalId, id], onDelete: Cascade)
  user  User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([canalId, creadoEn])
  @@index([canalId, videoId])
  @@map("actividad")
}

// ─────────────────────────── Automatizaciones (Fase 5) ───────────────────────────

/// Alertas del canal. Las abre y cierra el cron diario; quedan como historial.
model Alerta {
  id           String    @id @default(cuid())
  canalId      String    @map("canal_id")
  videoId      String?   @map("video_id")
  /// atrasado_produccion | atrasado_publicacion | colchon | cifras_sin_verificar
  tipo         String    @db.VarChar(40)
  /// Identifica la alerta para no duplicarla mientras siga abierta.
  clave        String    @db.VarChar(120)
  mensaje      String    @db.VarChar(500)
  gravedad     String    @default("aviso") @db.VarChar(10)
  abiertaEn    DateTime  @default(now()) @map("abierta_en")
  cerradaEn    DateTime? @map("cerrada_en")
  notificadaEn DateTime? @map("notificada_en")

  canal Canal  @relation(fields: [canalId], references: [id], onDelete: Cascade)
  video Video? @relation(fields: [canalId, videoId], references: [canalId, id], onDelete: Cascade)

  @@index([canalId, cerradaEn])
  @@index([canalId, clave])
  @@map("alertas")
}

enum EstadoInforme {
  borrador
  enviado
  error
}

/// Informes del canal: investigación semanal de referencias y resumen semanal.
model Informe {
  id            String        @id @default(cuid())
  canalId       String        @map("canal_id")
  /// investigacion | resumen_semanal
  tipo          String        @db.VarChar(30)
  /// Semana ISO en la zona del canal, p. ej. 2026-W43.
  semana        String        @db.VarChar(10)
  titulo        String        @db.VarChar(200)
  contenido     String        @db.LongText
  estado        EstadoInforme @default(borrador)
  datos         Json?
  costo         Decimal?      @db.Decimal(10, 4)
  ejecucionId   String?       @map("ejecucion_id")
  generadoPorId String?       @map("generado_por_id")
  aprobadoPorId String?       @map("aprobado_por_id")
  aprobadoEn    DateTime?     @map("aprobado_en")
  enviadoEn     DateTime?     @map("enviado_en")
  creadoEn      DateTime      @default(now()) @map("creado_en")
  actualizadoEn DateTime      @updatedAt @map("actualizado_en")

  canal       Canal @relation(fields: [canalId], references: [id], onDelete: Cascade)
  generadoPor User? @relation("InformeGeneradoPor", fields: [generadoPorId], references: [id], onDelete: SetNull)
  aprobadoPor User? @relation("InformeAprobadoPor", fields: [aprobadoPorId], references: [id], onDelete: SetNull)

  @@unique([canalId, tipo, semana])
  @@index([canalId, creadoEn])
  @@map("informes")
}
