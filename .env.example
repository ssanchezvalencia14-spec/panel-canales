# Copia este archivo a .env (local) o carga estas variables en el hosting.
# Nunca subas valores reales al repositorio.

# ── Base de datos (MySQL de Hostinger) ─────────────────────────────
# Desde la app en Hostinger el host es 127.0.0.1:3306 (no el srvNNNN.hstgr.io).
# Formato: mysql://USUARIO:CONTRASEÑA@127.0.0.1:3306/NOMBRE_BD
DATABASE_URL=

# ── Auth.js ────────────────────────────────────────────────────────
# Secreto aleatorio largo. Generar con: npx auth secret   (o: openssl rand -base64 32)
AUTH_SECRET=
# URL pública del panel (dominio provisional de Hostinger por ahora).
AUTH_URL=

# ── Correo (SMTP de Hostinger) para el enlace de acceso ─────────────
# Sin SMTP_HOST, en desarrollo el enlace se imprime en la consola del servidor.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
# Remitente, p. ej.: Panel <no-responder@tu-dominio.com>
EMAIL_FROM=

# ── Google: YouTube Analytics + Calendar (Fase 2) ──────────────────
# Credenciales OAuth de un proyecto de Google Cloud (tipo «Aplicación web»).
# URI de redirección autorizada: <AUTH_URL>/api/integraciones/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Clave para cifrar en la base los permisos de Google: 32 bytes en base64.
# Generar con: node -e "console.log(require(crypto).randomBytes(32).toString(base64))"
# Si se cambia, hay que volver a conectar Google en cada canal.
INTEGRACIONES_CLAVE=

# ── IA: borradores de guion (Fase 3) ───────────────────────────────
# Clave de la API de Claude (console.anthropic.com). Sin ella, el botón
# «Generar borrador» avisa que falta y no gasta nada.
ANTHROPIC_API_KEY=
# Opcional: modelo a usar (por defecto claude-opus-5-5).
ANTHROPIC_MODEL=

# ── Tareas periódicas ──────────────────────────────────────────────
# Secreto (mín. 16 caracteres) que exige /api/cron/sincronizar.
CRON_SECRET=

# ── Carga inicial ──────────────────────────────────────────────────
# Correo del primer superadmin de red (lo crea `npm run db:seed`).
SUPERADMIN_EMAIL=
# Año a usar si la agenda trae fechas sin año (p. ej. «lun 19 oct»).
AGENDA_ANIO=

# ── Identidad neutra del panel (opcional) ──────────────────────────
PANEL_NOMBRE=
# Acento del panel fuera de un canal, #RRGGBB. Cada canal usa el suyo.
PANEL_COLOR_ACENTO=

# ── Solo desarrollo (opcional) ─────────────────────────────────────
# Puerto del MySQL efímero de `npm run db:local` (por defecto 3307).
DB_LOCAL_PUERTO=

# Copias de seguridad (opcional). Carpeta fuera de la app; por defecto ~/respaldos-panel
RESPALDOS_DIR=
# Cuántos respaldos conservar (por defecto 14)
RESPALDOS_MAX=
